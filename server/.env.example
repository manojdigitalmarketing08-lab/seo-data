# Supabase (same project as before: pcmsotnmkxeriapajyco)
SUPABASE_URL=https://pcmsotnmkxeriapajyco.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Ads API (Keyword Planner)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=7368807029
GOOGLE_ADS_CUSTOMER_ID=2956427596

# PageSpeed Insights
PAGESPEED_API_KEY=

# Search Console — separate OAuth 2.0 Client ID (Web application) from the
# Google Ads one above. Enable the "Google Search Console API" and add scopes
# .../auth/webmasters.readonly + .../auth/userinfo.email on the consent screen.
# While the app is in "Testing" publishing status, only Google accounts added
# as test users can complete the connect flow.
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/gsc/callback
GSC_POST_AUTH_REDIRECT_URL=http://127.0.0.1:5500/dashboard.html

# Random 32+ byte string — signs the OAuth `state` param (CSRF protection).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=

# 32-byte hex key — encrypts stored GSC refresh tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# SERP data (powers the "currently ranking" section of /api/content-brief).
# Google's own Custom Search JSON API is closed to new Cloud projects, so this
# uses Serper.dev instead — get a key at https://serper.dev (2,500 free
# queries, then pay-as-you-go). Leave blank to skip this feature gracefully.
SERPER_API_KEY=

# Paddle (leave blank until you wire up billing; webhook route will just no-op)
PADDLE_API_KEY=
PADDLE_API_BASE=https://sandbox-api.paddle.com
PADDLE_WEBHOOK_SECRET=

# Optional: post a message here when the hourly rate-limit check trips
SLACK_WEBHOOK_URL=

# Origins allowed to call /dashboard-search-keywords from a browser (comma-separated),
# or '*' for any origin. Tighten this once the dashboard frontend has a real domain.
ALLOWED_DASHBOARD_ORIGIN=*

PORT=3000
