    {"id":"6fcc75d4-8ff2-4a10-8dd8-f165c483b69e","name":"Extract Transaction ID","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,-320],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const txnId = $json.body.data.id;\nreturn [{ json: { txnId } }];"}},
    {"id":"d7bf50b5-fb30-4374-81e1-6b388c96ae21","name":"Fetch Confirmed Transaction","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[660,-320],"parameters":{"method":"GET","url":"=https://sandbox-api.paddle.com/transactions/{{ $json.txnId }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"}},
    {"id":"169945e8-0787-4cf6-be4b-853785af43e2","name":"Extract Checkout Data","type":"n8n-nodes-base.code","typeVersion":2,"position":[880,-320],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const txn = $json.data;\nif (!txn || txn.status !== 'completed') {\n  return [];\n}\nconst email = txn.custom_data && txn.custom_data.email;\nconst plan = txn.custom_data && txn.custom_data.plan;\nconst quotaMap = { starter: 500, pro: 1000 };\nconst monthlyQuota = quotaMap[plan];\nif (!email || !plan || !monthlyQuota) {\n  throw new Error('PADDLE_WEBHOOK_ERROR: transaction ' + txn.id + ' missing custom_data.email/plan. email=' + email + ' plan=' + plan + '. Check the upgrade page is passing customData correctly.');\n}\nreturn [{ json: { email, plan, monthlyQuota, paddleCustomerId: txn.customer_id, paddleSubscriptionId: txn.subscription_id } }];"}},
    {"id":"c232ac5d-069e-4cbd-9519-815cc1110c87","name":"Activate Subscription","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1100,-320],"parameters":{"method":"PATCH","url":"=https://pcmsotnmkxeriapajyco.supabase.co/rest/v1/customers?email=eq.{{ encodeURIComponent($json.email) }}&select=id,email","authentication":"predefinedCredentialType","nodeCredentialType":"supabaseApi","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"},{"name":"Prefer","value":"return=representation"}]},"sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify({ plan: $json.plan, monthly_quota: $json.monthlyQuota, paddle_customer_id: $json.paddleCustomerId, paddle_subscription_id: $json.paddleSubscriptionId, status: \"active\" }) }}"}},
    {"id":"9f7573ee-19f2-4f1e-bc1f-93a2e2412103","name":"Verify Checkout Update","type":"n8n-nodes-base.code","typeVersion":2,"position":[1320,-320],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const items = $input.all();\nif (items.length === 0) {\n  const email = $('Extract Checkout Data').first().json.email;\n  throw new Error('PADDLE_WEBHOOK_ERROR: transaction.completed matched no customer row for email ' + email + '. They may have checked out with a different email than they signed up with -- needs manual reconciliation.');\n}\nreturn items;"}},
    {"id":"f07ab47f-097c-4af5-9e69-cc7c7eb3c7c7","name":"Extract Subscription ID (Updated)","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const subId = $json.body.data.id;\nreturn [{ json: { subId } }];"}},
    {"id":"d02c6417-3eed-483d-8331-9678d56fb7e5","name":"Fetch Confirmed Subscription (Updated)","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[660,0],"parameters":{"method":"GET","url":"=https://sandbox-api.paddle.com/subscriptions/{{ $json.subId }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"}},
    {"id":"e3c3030d-6af8-4462-af03-929955af98aa","name":"Extract Status","type":"n8n-nodes-base.code","typeVersion":2,"position":[880,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const sub = $json.data;\nconst statusMap = { active: 'active', trialing: 'active', past_due: 'past_due', paused: 'past_due', canceled: 'cancelled' };\nconst status = statusMap[sub.status] || 'past_due';\nreturn [{ json: { paddleSubscriptionId: sub.id, status } }];"}},
    {"id":"cee4ba33-df49-4398-a054-8906ca1a7d7f","name":"Sync Subscription Status","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1100,0],"parameters":{"method":"PATCH","url":"=https://pcmsotnmkxeriapajyco.supabase.co/rest/v1/customers?paddle_subscription_id=eq.{{ encodeURIComponent($json.paddleSubscriptionId) }}&select=id,email","authentication":"predefinedCredentialType","nodeCredentialType":"supabaseApi","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"},{"name":"Prefer","value":"return=representation"}]},"sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify({ status: $json.status }) }}"}},
    {"id":"0535dc54-71cd-4a3d-bcc7-4562f5460158","name":"Verify Status Update","type":"n8n-nodes-base.code","typeVersion":2,"position":[1320,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const items = $input.all();\nif (items.length === 0) {\n  const subId = $('Extract Status').first().json.paddleSubscriptionId;\n  throw new Error('PADDLE_WEBHOOK_ERROR: subscription.updated matched no customer row for subscription ' + subId + '.');\n}\nreturn items;"}},
    {"id":"30c33b8e-06a2-42a3-98a7-2963a030085b","name":"Extract Subscription ID (Canceled)","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,320],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const subId = $json.body.data.id;\nreturn [{ json: { subId } }];"}},
