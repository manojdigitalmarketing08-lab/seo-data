    {"id":"f23fbc39-1491-4721-be76-e4f50e5b4c95","name":"Gate Check","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"\nconst items = $input.all();\nconst trigger = $('Gated Trigger').item.json;\nif (!items || items.length === 0) { throw new Error('INVALID_API_KEY: no customer found for this key'); }\nconst customer = items[0].json;\nif (!customer || !customer.id) { throw new Error('INVALID_API_KEY: no customer found for this key'); }\nif (customer.status !== 'active') { throw new Error('ACCOUNT_INACTIVE: subscription status is ' + customer.status); }\nif (customer.quota_used_this_period >= customer.monthly_quota) { throw new Error('QUOTA_EXCEEDED: used ' + customer.quota_used_this_period + ' of ' + customer.monthly_quota + ' this period'); }\nconst strategy = (trigger.strategy || 'mobile').toLowerCase().trim();\nconst cacheKey = 'pagespeed::' + strategy + '::' + trigger.url.trim().toLowerCase();\nreturn [{ json: { customerId: customer.id, quotaUsed: customer.quota_used_this_period, monthlyQuota: customer.monthly_quota, cacheKey, url: trigger.url, strategy } }];\n"}},
