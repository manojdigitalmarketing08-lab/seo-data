    {"id":"1b195ebb-763f-466f-8b0a-5dd04e26d702","name":"Call Google Historical Metrics","type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[1100,140],"parameters":{"method":"POST","url":"https://googleads.googleapis.com/v22/customers/2956427596:generateKeywordHistoricalMetrics","authentication":"predefinedCredentialType","nodeCredentialType":"googleOAuth2Api","sendHeaders":true,"headerParameters":{"parameters":[{"name":"developer-token","value":"REPLACE_ME_GOOGLE_ADS_DEV_TOKEN"},{"name":"login-customer-id","value":"7368807029"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ (() => { const geoMap = { 'united states': '2840', 'us': '2840', 'usa': '2840', 'india': '2356', 'in': '2356', 'united kingdom': '2826', 'uk': '2826', 'canada': '2124', 'australia': '2036', 'germany': '2276', 'france': '2250', 'singapore': '2702', 'uae': '2784', 'global': null }; const loc = ($('Gate Check').item.json.location || 'india').toLowerCase().trim(); const geoId = geoMap.hasOwnProperty(loc) ? geoMap[loc] : '2356'; return JSON.stringify({ keywords: $('Gate Check').item.json.keywords.split(',').map(k => k.trim()), geoTargetConstants: geoId ? [`geoTargetConstants/${geoId}`] : [], keywordPlanNetwork: 'GOOGLE_SEARCH' }); })() }}"}},
