    {"id":"665f085d-4d59-4313-b29a-10c36d9a5f77","name":"Gate Check","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"\nconst items = $input.all();\nconst trigger = $('Gated Trigger').item.json;\nif (!items || items.length === 0) { throw new Error('INVALID_API_KEY: no customer found for this key'); }\nconst customer = items[0].json;\nif (!customer || !customer.id) { throw new Error('INVALID_API_KEY: no customer found for this key'); }\nif (customer.status !== 'active') { throw new Error('ACCOUNT_INACTIVE: subscription status is ' + customer.status); }\nif (customer.quota_used_this_period >= customer.monthly_quota) { throw new Error('QUOTA_EXCEEDED: used ' + customer.quota_used_this_period + ' of ' + customer.monthly_quota + ' this period'); }\nconst loc = (trigger.location || 'india').toLowerCase().trim();\nconst kws = trigger.keywords.split(',').map(k => k.trim().toLowerCase()).sort().join(',');\nconst cacheKey = 'historical::' + loc + '::' + kws;\nreturn [{ json: { customerId: customer.id, quotaUsed: customer.quota_used_this_period, monthlyQuota: customer.monthly_quota, cacheKey, keywords: trigger.keywords, location: trigger.location || 'India' } }];\n"}},
