    {"id":"e636d05a-e291-45bd-b9ae-d462a78605d9","name":"Gate Check","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"\nconst items = $input.all();\nconst trigger = $('Gated Trigger').item.json;\nif (!items || items.length === 0) {\n  throw new Error('INVALID_API_KEY: no customer found for this key');\n}\nconst customer = items[0].json;\nif (!customer || !customer.id) {\n  throw new Error('INVALID_API_KEY: no customer found for this key');\n}\nif (customer.status !== 'active') {\n  throw new Error('ACCOUNT_INACTIVE: subscription status is ' + customer.status);\n}\nif (customer.quota_used_this_period >= customer.monthly_quota) {\n  throw new Error('QUOTA_EXCEEDED: used ' + customer.quota_used_this_period + ' of ' + customer.monthly_quota + ' this period');\n}\nconst loc = (trigger.location || 'india').toLowerCase().trim();\nconst seeds = trigger.seedKeywords.split(',').map(k => k.trim().toLowerCase()).sort().join(',');\nconst cacheKey = loc + '::' + seeds;\n\nreturn [{\n  json: {\n    customerId: customer.id,\n    quotaUsed: customer.quota_used_this_period,\n    monthlyQuota: customer.monthly_quota,\n    cacheKey,\n    seedKeywords: trigger.seedKeywords,\n    location: trigger.location || 'India'\n  }\n}];\n"}},
