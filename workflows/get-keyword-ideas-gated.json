    {"id":"b2f482fc-3995-47e8-b047-772fd4eecaaf","name":"Format Cache Hit","type":"n8n-nodes-base.code","typeVersion":2,"position":[1100,-140],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const row = $input.first().json.row;\nreturn [{ json: { source: 'cache', cachedAt: row.cached_at, result: row.result_json } }];"}},
